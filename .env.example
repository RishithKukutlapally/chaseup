# Northgate ChaseUp — copy to .env (never commit .env). All data in this app is synthetic.

# Google Gemini (primary + fallback models). Leave empty to run in clearly-labelled SIMULATED mode.
GOOGLE_API_KEY=
# Optional: a second provider. If set, the fallback model switches to a different provider.
ANTHROPIC_API_KEY=

# Demo logins: username = first name lowercase. Password = this template with {Name} = first name,
# or, if it has no {Name}, one shared password for every user.
# Placeholder values containing "change-me" are ignored and a random suffix is generated + saved here.
DEMO_PASSWORD_TEMPLATE={Name}@change-me

# Optional overrides (defaults live in backend/app/config.py — the one place for model IDs and prices)
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# USD_TO_INR=88.0
# DEFAULT_MONTHLY_BUDGET_USD=25
# USER_HOURLY_LLM_CALL_LIMIT=60
# LLM_TIMEOUT_S=20
# SESSION_SECRET=   (else a random key is generated and stored in the DB)
# COOKIE_SECURE=1   (set when served over HTTPS)
